<odoo>

    <record id="hr_hospital_disease_infectious" model="hr.hospital.disease">
        <field name="name">Infectious Diseases</field>
        <field name="type">infectious</field>
    </record>

    <record id="hr_hospital_disease_neurological" model="hr.hospital.disease">
        <field name="name">Neurological Disorders</field>
        <field name="type">neurological</field>
    </record>

    <record id="hr_hospital_disease_covid" model="hr.hospital.disease">
        <field name="name">COVID-19</field>
        <field name="parent_id" ref="hr_hospital_disease_infectious"/>
        <field name="type">infectious</field>
    </record>

    <record id="hr_hospital_disease_flu" model="hr.hospital.disease">
        <field name="name">Influenza (Flu)</field>
        <field name="parent_id" ref="hr_hospital_disease_infectious"/>
        <field name="type">infectious</field>
    </record>

    <record id="hr_hospital_disease_measles" model="hr.hospital.disease">
        <field name="name">Measles</field>
        <field name="parent_id" ref="hr_hospital_disease_infectious"/>
        <field name="type">infectious</field>
    </record>

    <record id="hr_hospital_disease_migraine" model="hr.hospital.disease">
        <field name="name">Migraine</field>
        <field name="parent_id" ref="hr_hospital_disease_neurological"/>
        <field name="type">neurological</field>
    </record>

    <record id="hr_hospital_disease_epilepsy" model="hr.hospital.disease">
        <field name="name">Epilepsy</field>
        <field name="parent_id" ref="hr_hospital_disease_neurological"/>
        <field name="type">neurological</field>
    </record>

    <record id="hr_hospital_disease_meningitis" model="hr.hospital.disease">
        <field name="name">Meningitis</field>
        <field name="parent_id" ref="hr_hospital_disease_neurological"/>
        <field name="type">neurological</field>
    </record>
</odoo>
