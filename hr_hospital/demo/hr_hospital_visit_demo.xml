<odoo>

    <record id="hr_hospital_visit_1" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_1"/>
        <field name="doctor_id" ref="hr_hospital_doctor_1"/>
        <field name="status">scheduled</field>
        <field name="scheduled_visit_datetime" eval="DateTime.now().strftime('%Y-%m-%d 09:00:00')"/>
    </record>

    <record id="hr_hospital_visit_2" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_2"/>
        <field name="doctor_id" ref="hr_hospital_doctor_2"/>
        <field name="status">completed</field>
        <field name="scheduled_visit_datetime" eval="DateTime.now().strftime('%Y-%m-%d 10:00:00')"/>
        <field name="actual_visit_datetime" eval="DateTime.now().strftime('%Y-%m-%d 10:20:00')"/>
    </record>

    <record id="hr_hospital_visit_3" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_3"/>
        <field name="doctor_id" ref="hr_hospital_doctor_3"/>
        <field name="status">cancelled</field>
        <field name="scheduled_visit_datetime" eval="DateTime.now().strftime('%Y-%m-%d 11:30:00')"/>
    </record>

    <record id="hr_hospital_visit_4" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_4"/>
        <field name="doctor_id" ref="hr_hospital_doctor_1"/>
        <field name="status">completed</field>
        <field name="scheduled_visit_datetime" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d 15:00:00')"/>
        <field name="actual_visit_datetime" eval="(DateTime.now() - timedelta(days=1)).strftime('%Y-%m-%d 15:05:00')"/>
    </record>

    <record id="hr_hospital_visit_5" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_5"/>
        <field name="doctor_id" ref="hr_hospital_doctor_2"/>
        <field name="status">scheduled</field>
        <field name="scheduled_visit_datetime" eval="(DateTime.now() - timedelta(days=2)).strftime('%Y-%m-%d 13:30:00')"/>
    </record>

    <record id="hr_hospital_visit_6" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_6"/>
        <field name="doctor_id" ref="hr_hospital_doctor_3"/>
        <field name="status">completed</field>
        <field name="scheduled_visit_datetime" eval="(DateTime.now() - timedelta(days=3)).strftime('%Y-%m-%d 08:00:00')"/>
        <field name="actual_visit_datetime" eval="(DateTime.now() - timedelta(days=3)).strftime('%Y-%m-%d 08:20:00')"/>
    </record>

    <record id="hr_hospital_visit_7" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_7"/>
        <field name="doctor_id" ref="hr_hospital_doctor_2"/>
        <field name="status">scheduled</field>
        <field name="scheduled_visit_datetime" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 11:15:00')"/>
    </record>

    <record id="hr_hospital_visit_8" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_3"/>
        <field name="doctor_id" ref="hr_hospital_doctor_1"/>
        <field name="status">scheduled</field>
        <field name="scheduled_visit_datetime" eval="(DateTime.now() + timedelta(days=2)).strftime('%Y-%m-%d 14:45:00')"/>
    </record>

    <record id="hr_hospital_visit_9" model="hr.hospital.visit">
        <field name="patient_id" ref="hr_hospital_patient_2"/>
        <field name="doctor_id" ref="hr_hospital_doctor_3"/>
        <field name="status">scheduled</field>
        <field name="scheduled_visit_datetime" eval="(DateTime.now() + timedelta(days=3)).strftime('%Y-%m-%d 10:00:00')"/>
    </record>

</odoo>
