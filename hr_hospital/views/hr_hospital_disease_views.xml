<odoo>

    <record id="hr_hospital_disease_tree" model="ir.ui.view">
        <field name="name">hr.hospital.disease.tree</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <tree default_order="parent_path" default_group_by="parent_id">
                <field name="display_name" string="Disease name"/>
                <field name="type" string="Disease Type" widget="badge"/>
                <field name="parent_id"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_disease_form" model="ir.ui.view">
        <field name="name">hr.hospital.disease.form</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="type" string="Disease Type"/>
                        <field name="parent_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_disease_search" model="ir.ui.view">
        <field name="name">hr.hospital.disease.search</field>
        <field name="model">hr.hospital.disease</field>
        <field name="arch" type="xml">
            <search>
                <searchpanel>
                    <field name="parent_id" select="one" hierarchize="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="action_hr_hospital_disease" model="ir.actions.act_window">
        <field name="name">Diseases</field>
        <field name="res_model">hr.hospital.disease</field>
        <field name="view_mode">tree,form,search</field>
    </record>

    <menuitem id="hr_hospital_menu_diseases"
              parent="hr_hospital_menu_reference"
              action="action_hr_hospital_disease"
              name="Diseases"
              sequence="10"/>

</odoo>
