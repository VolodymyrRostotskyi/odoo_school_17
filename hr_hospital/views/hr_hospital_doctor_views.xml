<odoo>

    <record id="hr_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.tree</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hr.hospital.doctor.form</field>
        <field name="model">hr.hospital.doctor</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group col="3">
                        <group string="Personal Info">
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="gender"/>
                        </group>
                        <group string="Medical Role">
                            <field name="specialty"/>
                            <field name="is_intern"/>
                            <field name="mentor_id"
                                   invisible="not is_intern"/>
                        </group>
                        <group>
                            <field name="photo" widget='image'
                                   class="oe_avatar m-0"
                                   options='{"zoom": true, "preview_image":"avatar_256"}'/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Patients">
                            <field name="patient_ids">
                                <tree>
                                    <field name="name"/>
                                </tree>
                            </field>
                        </page>
<!--                        <page string="Visits">-->
<!--                             <field name="visit_ids">-->
<!--                                <tree>-->
<!--                                    <field name="patient_id"/>-->
<!--                                    <field name="doctor_id"/>-->
<!--                                    <field name="scheduled_visit_datetime"/>-->
<!--                                    <field name="status"/>-->
<!--                                    <field name="actual_visit_datetime"/>-->
<!--                                </tree>-->
<!--                            </field>-->
<!--                        </page>-->
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.doctor</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hr_hospital_menu_doctors"
              parent="hr_hospital_menu_registry"
              action="action_hr_hospital_doctor"
              name="Doctors"
              sequence="60"/>

</odoo>
