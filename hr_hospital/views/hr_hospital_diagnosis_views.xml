<odoo>

    <record id="hr_hospital_diagnosis_tree" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.tree</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id"/>
                <field name="doctor_id"/>
                <field name="disease_id"/>
                <field name="is_approved"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_diagnosis_form" model="ir.ui.view">
        <field name="name">hr.hospital.diagnosis.form</field>
        <field name="model">hr.hospital.diagnosis</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="disease_id"/>
                            <field name="visit_id"/>
                        </group>
                        <group>
                            <field name="is_doctor_intern" invisible="1"/>
                            <field name="mentor_id"
                                   invisible="not is_doctor_intern"/>
                            <field name="is_approved_by_mentor"
                                   invisible="not is_doctor_intern"/>
                            <field name="is_approved"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Treatment Description">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_diagnosis" model="ir.actions.act_window">
        <field name="name">Diagnoses</field>
        <field name="res_model">hr.hospital.diagnosis</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hr_hospital_menu_diagnosis"
              parent="hr_hospital_menu_diagnoses"
              action="action_hr_hospital_diagnosis"
              name="Diagnosis"
              sequence="70"/>

</odoo>