<odoo>

    <record id="hr_hospital_visit_tree" model="ir.ui.view">
        <field name="name">hr.hospital.visit.tree (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <tree>
                <field name="patient_id" widget="many2one_avatar_user"/>
                <field name="doctor_id" widget="many2one_avatar_user"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'scheduled'"
                       decoration-success="status == 'completed'"
                       decoration-danger="status == 'cancelled'"/>
                <field name="scheduled_visit_datetime"/>
                <field name="actual_visit_datetime"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_visit_form" model="ir.ui.view">
        <field name="name">hr.hospital.visit.form (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <form string="Patient Visit">
                <header>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            invisible="not id or status != 'scheduled'"
                            class="btn btn-success"
                            help="Confirming the visit. Once confirmed, it can no longer be cancelled or reverted to a previous status."/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="not id or status != 'scheduled'"
                            class="btn btn-outline-danger"
                            help="Cancelling the visit. Once cancelled, it can no longer be confirmed or reverted to a previous status."/>
                    <div class="alert alert-warning text-center mb-0"
                         role="status"
                         invisible="id">
                        Status change is available only after the record has
                        been saved.
                    </div>
                    <div class="alert alert-info text-center mb-0"
                         role="status"
                         invisible="status == 'scheduled' or not id">
                        This visit is already in a final status. Status
                        change is no longer possible.
                    </div>
                </header>
                <sheet>
                    <group col="3">
                        <field name="status"
                               widget="statusbar"
                               help="Can only be changed when the status is 'Scheduled'. Once the visit is confirmed or cancelled, the status becomes locked."/>
                        <separator/>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                        </group>
                        <group>
                            <field name="scheduled_visit_datetime"/>
                            <field name="actual_visit_datetime"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Diagnoses">
                            <field name="diagnosis_ids">
                                <tree>
                                    <field name="doctor_id"/>
                                    <field name="disease_id"/>
                                    <field name="is_approved"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_hospital_visit_calendar" model="ir.ui.view">
        <field name="name">hr.hospital.visit.calendar (hr_hospital_visit)
        </field>
        <field name="model">hr.hospital.visit</field>
        <field name="priority" eval="10"/>
        <field name="arch" type="xml">
            <calendar string="Patient Visits"
                      mode="month"
                      date_start="scheduled_visit_datetime"
                      color="patient_id">
                <field name="patient_id" avatar_field="avatar_128"/>
                <field name="doctor_id" avatar_field="avatar_128"/>
                <field name="status"/>
            </calendar>
        </field>
    </record>

    <record id="hr_hospital_visit_search" model="ir.ui.view">
        <field name="name">hr.hospital.visit.search (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <search string="Search Visits">
                <filter name="status_scheduled" string="Scheduled"
                        default_period="today"
                        domain="[('status','=','scheduled')]"/>
                <filter name="filter_this_month"
                    string="This Month"
                    date="scheduled_visit_datetime"
                    default_period="this_month"/>
                <filter name="status_scheduled" string="Scheduled"
                        default_period="today"
                        domain="[('status','=','scheduled')]"/>
                <filter name="patient_id" string="Patient"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="status"
                            context="{'group_by':'status'}"/>
                    <filter string="Doctor" name="doctor_id"
                            context="{'group_by':'doctor_id'}"/>
                </group>
                <searchpanel>
                    <field name="status"
                           icon="fa-list"/>
                    <field name="doctor_id"
                           select="multi"
                           enable_counters="1"
                           icon="fa-user-md"/>
                    <field name="patient_id"
                           enable_counters="1"
                           limit="10"
                           icon="fa-user"/>
                    <separator/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="hr_hospital_visit_pivot" model="ir.ui.view">
        <field name="name">hr.hospital.visit.pivot (hr_hospital_visit)</field>
        <field name="model">hr.hospital.visit</field>
        <field name="arch" type="xml">
            <pivot>
                <field name="doctor_id" type="row"/>
                <field name="scheduled_visit_datetime" type="col"/>
                <field name="status" type="col"/>
            </pivot>
        </field>
    </record>

    <record id="action_hr_hospital_visit" model="ir.actions.act_window">
        <field name="name">Visits</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.visit</field>
        <field name="view_mode">tree,form,calendar,pivot</field>
    </record>

    <menuitem id="hr_hospital_menu_visit"
              parent="hr_hospital_menu_visits"
              action="action_hr_hospital_visit"
              name="Visits"
              sequence="50"/>

</odoo>
