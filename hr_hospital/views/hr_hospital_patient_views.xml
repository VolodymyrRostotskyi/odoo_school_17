<odoo>

    <record id="hr_hospital_patient_tree" model="ir.ui.view">
        <field name="name">hr.hospital.patient.tree</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="gender"/>
                <field name="age"/>
                <field name="doctor_id"/>
            </tree>
        </field>
    </record>

    <record id="hr_hospital_patient_form" model="ir.ui.view">
        <field name="name">hr.hospital.patient.form</field>
        <field name="model">hr.hospital.patient</field>
        <field name="arch" type="xml">
            <form>
                <header></header>
                <sheet>
                    <group col="3">
                        <group string="Personal Information">
                            <field name="name"/>
                            <field name="doctor_id"/>
                            <field name="phone" widget="phone"/>
                            <field name="gender"/>
                            <field name="birth_date"/>
                            <field name="age"/>
                        </group>
                        <div>
                            <group string="Emergency Contact Information">
                                <field name="emergency_contact_name"/>
                                <field name="emergency_contact_phone"
                                       widget="phone"/>
                            </group>
                            <group string="Passport Details">
                                <field name="tax_id_number"/>
                                <field name="passport_number"/>
                                <field name="passport_issuer"/>
                                <field name="passport_issue_date"/>
                            </group>
                        </div>
                        <group>
                            <field name="photo"
                                   widget='image'
                                   nclass="oe_avatar m-0"
                                   options='{"zoom": true, "preview_image":"avatar_128"}'/>
                        </group>
                    </group>

<!--                    <notebook>-->
<!--                        <page string="Visits">-->
<!--                            <field name="visit_ids">-->
<!--                                <tree>-->
<!--                                    <field name="patient_id"/>-->
<!--                                    <field name="doctor_id"/>-->
<!--                                    <field name="scheduled_visit_datetime"/>-->
<!--                                    <field name="status"/>-->
<!--                                    <field name="actual_visit_datetime"/>-->
<!--                                </tree>-->
<!--                            </field>-->
<!--                        </page>-->
<!--                    </notebook>-->
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_hospital_patient" model="ir.actions.act_window">
        <field name="name">Patients</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.hospital.patient</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hr_hospital_menu_patients"
              parent="hr_hospital_menu_registry"
              action="action_hr_hospital_patient"
              name="Patients"
              sequence="50"/>

</odoo>
